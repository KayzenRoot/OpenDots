{
  "display_information": {
    "name": "NexBot",
    "description": "Self-hosted NexBot agent over Slack.",
    "background_color": "#1a1a1a"
  },
  "features": {
    "bot_user": {
      "display_name": "NexBot",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE_WITH_PUBLIC_HOST/api/slack/events",
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
