# NexBot as a hardened systemd service (alternative to Compose restart
# policies). Install to /etc/systemd/system/nexbot.service, then:
#
#   sudo useradd --system --home /opt/nexbot --shell /usr/sbin/nologin nexbot
#   sudo usermod -aG docker nexbot
#   sudo chown -R nexbot:nexbot /opt/nexbot
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nexbot
#
# Requirements:
#   * The repo lives at /opt/nexbot with a filled-in .env (docker compose
#     reads .env from WorkingDirectory; do NOT put secrets in Environment=).
#   * The `nexbot` user must be in the `docker` group to reach the daemon;
#     membership in `docker` is root-equivalent, so treat this user as
#     privileged and give it no other duties.
#   * Keep compose.yml's `restart: unless-stopped` too; systemd restarts the
#     `docker compose up` process, Compose restarts individual containers.

[Unit]
Description=NexBot (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nexbot
# Runs on boot and on `systemctl start`. `--remove-orphans` cleans up services
# removed from the compose files between upgrades.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --remove-orphans
TimeoutStartSec=0
TimeoutStopSec=120

# Dedicated, unprivileged user (must be in the docker group; see above).
User=nexbot
Group=nexbot

# Hardening. Docker needs a writable home-independent state; keep the sandbox
# modest so the compose client and the daemon socket keep working.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# docker compose must read the repo and write to the volumes it manages.
ReadWritePaths=/opt/nexbot

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
